# Copy to .env.local and fill in real values. Never commit .env.local.
# See CLAUDE.md for the Clerk + Supabase Third-Party Auth setup steps these
# keys depend on.

# ── Clerk (auth) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Supabase (Postgres only — NOT Supabase's own Auth, see CLAUDE.md) ────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Service-role Supabase access (lib/supabase/serviceRole.ts) ───────────
# SUPABASE_SERVICE_ROLE_KEY — Supabase dashboard -> Settings -> API -> service_role key.
#   Server-only. NEVER prefix with NEXT_PUBLIC_. NEVER put in wrangler.toml.
#   Two consumers: (1) the Clerk->Supabase webhook below, (2) the question-bank
#   grading Server Actions (app/question-bank/actions.ts) — reading
#   question_answers and writing attempt grading fields both require it, since
#   neither has an authenticated-role RLS policy by design (see
#   docs/question-bank-schema.sql). Without this key, question-bank practice
#   attempts cannot be graded at all — this is no longer an optional key.
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk -> Supabase webhook sync (app/api/webhooks/clerk/route.ts) ─────
# Both required together, or that route is a harmless no-op (501) — but see
# above, SUPABASE_SERVICE_ROLE_KEY is still required regardless for grading.
# The always-on fallback sync (lib/supabase/ensureUser.ts) needs neither of
# these and works without any webhook configured.
# CLERK_WEBHOOK_SIGNING_SECRET — Clerk dashboard -> Webhooks -> your endpoint -> Signing Secret.
CLERK_WEBHOOK_SIGNING_SECRET=

# ── AI assistant (app/api/ai/route.ts) ───────────────────────────────────
# No API-key var needed — runs on Cloudflare Workers AI via the native
# env.AI binding in wrangler.jsonc (see the "ai" key there), not an
# Anthropic account. Swapped 2026-09-11, see docs/OPERATIONAL-GUIDE.md.
# AI_ASSISTANT_ENABLED — kill switch. Anything other than the literal string
# "true" keeps the endpoint fully closed (no Workers AI calls, zero cost) even
# for signed-in users. Defaults to "false" in wrangler.jsonc.
AI_ASSISTANT_ENABLED=false

# ── Social integrations (custom-worker.ts, lib/social/telegramDispatch.ts) ─
# TELEGRAM_BOT_TOKEN — one SynfraCore-owned bot (BotFather), not per-user
# OAuth. Server-only. Set as a `wrangler secret put TELEGRAM_BOT_TOKEN` for
# production, same as CLERK_SECRET_KEY — never in wrangler.jsonc's plain
# vars. Powers the scheduled() Cron Trigger dispatch job for scheduled
# Telegram posts (docs/social-integrations-schema.sql).
TELEGRAM_BOT_TOKEN=

# ── Email (app/api/digest/route.ts, app/api/subscribe/route.ts) ─────────
# RESEND_API_KEY — resend.com dashboard. Both routes degrade gracefully
# (log-only / no-op) if this is unset, so it's optional for local dev.
RESEND_API_KEY=
# DIGEST_SECRET — shared secret the /api/digest caller must present; pick
# any long random string, it isn't tied to any external service.
DIGEST_SECRET=

# ── Error tracking (instrumentation.ts, instrumentation-client.ts) ──────
# NEXT_PUBLIC_SENTRY_DSN — Sentry dashboard -> Settings -> Projects -> your
# project -> Client Keys (DSN). Public/safe to expose (write-only ingest
# endpoint, not a secret). Everything Sentry-related no-ops safely and costs
# nothing if this is left unset.
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN — optional, only needed for
# next.config.ts's sourcemap-upload step (readable stack traces in the
# Sentry UI). Build succeeds without them; sourcemap upload is just skipped.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Analytics (app/layout.tsx) ───────────────────────────────────────────
# NEXT_PUBLIC_CF_BEACON_TOKEN — Cloudflare dashboard -> Analytics & Logs ->
# Web Analytics -> Add a site -> copy the "token" value out of the generated
# beacon snippet. No cookies, no persistent client identifiers; data stays in
# Cloudflare's own dashboard. Public/safe to expose (it's embedded in the
# page HTML either way). Leave unset locally — the beacon script only renders
# when this is set, so local/preview traffic never reports under production's
# token.
NEXT_PUBLIC_CF_BEACON_TOKEN=

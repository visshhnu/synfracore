{
  "name": "synfracore",
  // Points at custom-worker.ts, not directly at the OpenNext-generated
  // .open-next/worker.js — @opennextjs/cloudflare has no built-in support
  // for a scheduled() Cron Trigger handler (confirmed live against its own
  // docs), so custom-worker.ts wraps the generated worker's fetch handler
  // and adds scheduled() alongside it, per OpenNext's own documented
  // "Custom Worker" pattern. See custom-worker.ts for the Telegram
  // scheduled-post dispatch this powers (Phase 2).
  "main": "custom-worker.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Public, non-secret values only — every NEXT_PUBLIC_* var is inlined into
  // the client-side JS bundle at build time regardless of where it's stored,
  // so there's nothing to protect by keeping these out of git.
  // CLERK_SECRET_KEY is the opposite (genuinely sensitive) and must stay a
  // Dashboard-only Secret — never add it here.
  "vars": {
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuc3luZnJhY29yZS5jb20k",
    "NEXT_PUBLIC_SUPABASE_URL": "https://jlbyduuutwxcjaxtgsdw.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_yDwcAvvY2eX2hchsUaf8ww_aXXO4wfZ",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/sign-in",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/sign-up",
    "NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL": "/",
    "NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL": "/",

    // Kill switch for /api/ai (app/api/ai/route.ts) — while "false" (the safe
    // default), the endpoint never calls Workers AI at all, at any cost, even
    // for signed-in users. Flipped back to "true" 2026-09-11 for a second
    // manual click-through, on BOTH /api/ai consumers this time
    // (components/tech/SectionContent.tsx AND app/ai-assistant/AIAssistantClient.tsx)
    // — the first attempt caught a stale-response-shape bug in the second
    // consumer, now fixed. See docs/OPERATIONAL-GUIDE.md.
    "AI_ASSISTANT_ENABLED": "true"
  },

  "kv_namespaces": [
    { "binding": "BLOG_KV", "id": "57d60b769fbe4ae6be430d9dc4975f00" }
  ],

  // Workers AI — powers /api/ai (app/api/ai/route.ts) once AI_ASSISTANT_ENABLED
  // is flipped to "true". No separate service/dashboard signup required (works
  // on the plain Free Workers plan up to 10,000 Neurons/day); this binding is
  // config-only, same weight as the KV binding above.
  "ai": { "binding": "AI" },

  // Cron Trigger for custom-worker.ts's scheduled() handler — the Telegram
  // scheduled-post dispatch job (Phase 2). Genuinely new infrastructure
  // (this account had zero Cron Triggers before this), not a config no-op
  // like the AI binding above — approved 2026-09-12. Free plan allows 5 Cron
  // Triggers per account (confirmed live); this uses 1. Every 2 minutes is
  // the approved cadence — worst case a scheduled post goes out up to 2
  // minutes late.
  "triggers": {
    "crons": ["*/2 * * * *"]
  }
}

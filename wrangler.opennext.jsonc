{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "synfracore-opennext-poc",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "synfracore-opennext-poc" }
  ],
  "vars": {
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_ZW5nYWdlZC1ib2JjYXQtOC5jbGVyay5hY2NvdW50cy5kZXYk",
    "NEXT_PUBLIC_SUPABASE_URL": "https://jlbyduuutwxcjaxtgsdw.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_yDwcAvvY2eX2hchsUaf8ww_aXXO4wfZ",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/sign-in",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/sign-up",
    "NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL": "/",
    "NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL": "/",
    "AI_ASSISTANT_ENABLED": "false"
  },
  "kv_namespaces": [
    { "binding": "BLOG_KV", "id": "57d60b769fbe4ae6be430d9dc4975f00" }
  ]
}

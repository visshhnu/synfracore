{
  "name": "synfracore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pages:build": "npm run generate:content-registry && npm run generate:labs-existence && opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "predeploy": "npm run validate:roadmaps && npm run validate:content-quality && npm run validate:no-hardcoded-stats",
    "deploy": "npm run pages:build && wrangler deploy",
    "validate:roadmaps": "node scripts/run-validate-roadmaps.mjs",
    "validate:content-quality": "node scripts/validate-content-quality.mjs",
    "validate:no-hardcoded-stats": "node scripts/validate-no-hardcoded-stats.mjs",
    "generate:content-registry": "node scripts/generate-content-registry.mjs",
    "generate:labs-existence": "node scripts/generate-labs-existence.mjs",
    "generate:og-images": "node scripts/generate-og-images.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.12",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/typography": "^0.5.19",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.17.0",
    "next": "15.5.20",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "playwright": "^1.62.1",
    "satori": "^0.28.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.111.0"
  }
}

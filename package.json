{
  "name": "synfracore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pages:build": "npm run generate:content-registry && npx @cloudflare/next-on-pages@1",
    "predeploy": "npm run validate:roadmaps && npm run validate:content-quality && npm run validate:no-hardcoded-stats",
    "deploy": "npm run pages:build && wrangler pages deploy",
    "validate:roadmaps": "node scripts/run-validate-roadmaps.mjs",
    "validate:content-quality": "node scripts/validate-content-quality.mjs",
    "validate:no-hardcoded-stats": "node scripts/validate-no-hardcoded-stats.mjs",
    "generate:content-registry": "node scripts/generate-content-registry.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.12",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/typography": "^0.5.19",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.17.0",
    "next": "15.5.20",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
